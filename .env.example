# --- Required: Qloo taste graph (personas) ---
QLOO_API_KEY=
# Hackathon keys only work on the hackathon host; use https://api.qloo.com for production keys.
QLOO_BASE_URL=https://hackathon.api.qloo.com

# --- Required: NVIDIA open model on Nebius Token Factory (extraction + fix agent) ---
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Must be an NVIDIA model served for your key; the status pill checks it against /v1/models.
NEBIUS_MODEL=nvidia/Nemotron-3-Nano-30B-A3B
# Optional: your per-million-token USD rates, used to estimate cost per audit from real usage.
NEBIUS_INPUT_PRICE_PER_MILLION=
NEBIUS_OUTPUT_PRICE_PER_MILLION=

# --- Required: at least one assistant under test ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional extra assistants (any OpenAI-compatible chat completions endpoint)
MODEL_2_API_KEY=
MODEL_2_BASE_URL=
MODEL_2_ID=
MODEL_2_NAME=
MODEL_3_API_KEY=
MODEL_3_BASE_URL=
MODEL_3_ID=
MODEL_3_NAME=

# Optional: where audits and raw responses are cached (default ./.data)
TASTEPROBE_DATA_DIR=
