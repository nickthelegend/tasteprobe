# --- Required: Qloo taste graph (personas) ---
QLOO_API_KEY=
# Hackathon keys only work on the hackathon host; use https://api.qloo.com for production keys.
QLOO_BASE_URL=https://hackathon.api.qloo.com

# --- Required: NVIDIA open model on Nebius Token Factory (extraction + fix agent) ---
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Must be an NVIDIA model served for your key; the status pill checks it against /v1/models.
NEBIUS_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# Optional: your per-million-token USD rates, used to estimate cost per audit from real usage.
NEBIUS_INPUT_PRICE_PER_MILLION=
NEBIUS_OUTPUT_PRICE_PER_MILLION=
# Optional reasoning settings; unset sends nothing (model default).
# reasoning_effort is a documented Nebius chat-completions field: none|minimal|low|medium|high|xhigh|max
NEBIUS_REASONING_EFFORT=
# on|off sends chat_template_kwargs.enable_thinking (NVIDIA model card, vLLM; not documented by Nebius)
NEBIUS_THINKING=

# --- Required: at least one assistant under test ---
# Minimum setup is TWO keys (Qloo + Nebius): leave OPENAI_API_KEY empty and run the assistant
# under test on Nebius Token Factory through MODEL_2_*, using your Nebius key again:
#   MODEL_2_BASE_URL=https://api.tokenfactory.nebius.com/v1
#   MODEL_2_API_KEY=<the same value as NEBIUS_API_KEY>
#   MODEL_2_ID=<a non-NVIDIA chat model from your key's /v1/models list, e.g. a Llama, Qwen or DeepSeek model>
#   MODEL_2_NAME=<the label shown in the app>
# Nemotron (NEBIUS_MODEL) still extracts every answer and runs the agent; the MODEL_2 model is the
# assistant being audited. The three MODEL_2_* values go together: a partial slot is reported as
# Setup required, never ignored.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional extra assistants (any OpenAI-compatible chat completions endpoint)
MODEL_2_API_KEY=
MODEL_2_BASE_URL=
MODEL_2_ID=
MODEL_2_NAME=
MODEL_3_API_KEY=
MODEL_3_BASE_URL=
MODEL_3_ID=
MODEL_3_NAME=

# Optional: where audits and raw responses are cached (default ./.data)
TASTEPROBE_DATA_DIR=

# Optional spend guard (see docs/hosting.md). In production (npm start, Docker) paid runs need
# TASTEPROBE_RUN_TOKEN, or TASTEPROBE_RUNS_OPEN=1 for a private server.
TASTEPROBE_RUN_TOKEN=
TASTEPROBE_RUNS_OPEN=
# Header the proxy sets with the client address (x-real-ip on Railway). Unset = one shared bucket.
TASTEPROBE_TRUSTED_IP_HEADER=
# Wall-clock limit for one audit, fix or agent run, in seconds (default 900).
TASTEPROBE_RUN_DEADLINE_SECONDS=
# Live Qloo calls the agent's qloo_insights tool may make per run (default 12, one per turn).
TASTEPROBE_AGENT_MAX_QLOO_CALLS=
